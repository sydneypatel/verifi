# Copy this file to .env (same folder) and fill in.

# The SEC asks every automated client to identify itself with a name and contact email.
# Required for live checks. Not needed for the demo (fixture) mode.
SEC_USER_AGENT="HypeCheck (class project) your-email@example.com"

# Optional. With a key, claims are extracted by an LLM (handles company names,
# loose phrasing, several claims per sentence). Without one, a simple
# rule-based extractor is used so everything still runs.
ANTHROPIC_API_KEY=

# Optional. Which model extracts claims.
HYPECHECK_MODEL=claude-haiku-4-5-20251001

# Optional. API port for local dev.
PORT=8787

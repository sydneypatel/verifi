{
  "name": "@hypecheck/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:demo": "tsx watch src/server.ts --fixtures",
    "start": "tsx src/server.ts",
    "check": "tsx src/cli.ts",
    "check:demo": "tsx src/cli.ts --fixtures",
    "typecheck": "tsc -p tsconfig.json",
    "build:api": "esbuild src/vercel.ts --bundle --platform=node --target=node20 --format=esm --outfile=../../api/check.js --banner:js=\"// Generated by npm run build:api from apps/api/src/vercel.ts. Do not edit by hand.\""
  },
  "dependencies": {
    "@hypecheck/check-core": "*",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0"
  }
}
